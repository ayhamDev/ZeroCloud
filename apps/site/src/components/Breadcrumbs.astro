---
interface Props {
  items: { text: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {items.map((item) => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.text}</a>
        ) : (
          <span aria-current="page">{item.text}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
