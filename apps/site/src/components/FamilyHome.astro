---
import { featuredProducts } from '../lib/catalog';
import { allApps } from '../lib/content';
import { appLink, link } from '../lib/site';
import CloudMark from './CloudMark.astro';
import Field from './Field.astro';
import ProductMark from './ProductMark.astro';
import ProjectMeaning from './ProjectMeaning.astro';
import RevealText from './RevealText.astro';

const apps = await allApps();
const featured = featuredProducts(apps);
---

<div class="frame home-sections">
  <section class="family-cover" aria-labelledby="family-title" data-enter data-reveal-panel>
    <Field />
    <div class="cover-type">
      <h1 id="family-title" class="cover-title" data-enter>
        <span class="cover-line"><RevealText text="Software for" /></span>{' '}
        <span class="cover-line"><RevealText text="your own devices." /></span>
      </h1>
      <p class="cover-lead" data-enter>
        Share files, sync a collection or cast a screen. Choose the apps that fit your devices.
      </p>
      <div class="actions" data-enter>
        <a class="btn primary" href={link('apps/')}>Explore the apps</a>
        <a class="text-link" href="#what-is-zerocloud">What ZeroCloud means</a>
      </div>
    </div>
    <CloudMark />
  </section>
  <ProjectMeaning />
  <section class="principle-strip" aria-labelledby="philosophy-title">
    <div class="principle-copy">
      <h2 id="philosophy-title" class="eyeline" data-enter>Our philosophy</h2>
      <p class="pull" data-enter>
        <RevealText text="Your devices. Your data. Your choice." />
      </p>
    </div>
    <div class="family-security" data-enter>
      <h3>Secure by default.</h3>
      <p>
        Encryption is a requirement for the data our apps store or exchange. You choose which
        devices have access.
      </p>
      <a class="text-link" href={link('project/')}>Read our principles</a>
    </div>
  </section>
  <section class="home-directory" aria-labelledby="directory-title">
    <div class="section-intro">
      <h2 id="directory-title" data-enter><RevealText text="Inside ZeroCloud" /></h2>
      <p data-enter>One app at a time. Your choice, always.</p>
    </div>
    <div class="product-grid">
      {featured.map((app) => (
        <article class="product-card" data-product={app.id} data-enter>
          <div class="product-card-top">
            <ProductMark id={app.id} motion="once" />
            {app.id === 'hub' && <span class="product-kind">Optional companion</span>}
          </div>
          <div>
            <h3>{app.data.name}</h3>
            <p>{app.data.description}</p>
          </div>
          <div class="product-card-bottom">
            <a class="text-link" href={appLink(app.id)}>
              Explore {app.data.shortName}
            </a>
          </div>
        </article>
      ))}
    </div>
    {apps.length > featured.length && (
      <p class="directory-note" data-enter>
        <a class="text-link" href={link('apps/')}>
          Explore all {apps.length} apps
        </a>
      </p>
    )}
    <p class="directory-note" data-enter>
      Hub brings your apps together. Individual downloads remain yours to choose.
      <a class="text-link" href={link('downloads/')}>See download availability</a>
    </p>
  </section>
</div>
