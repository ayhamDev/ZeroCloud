---
import type { Product } from '../lib/content';
import { channelLabels, fileSize, newestFirst, releaseDate } from '../lib/releases';
import { githubReleaseRepository } from '../lib/site';
import '../styles/archive.css';
import RevealText from './RevealText.astro';

interface Props {
  apps: Product[];
}
const { apps } = Astro.props;
const builds = apps
  .flatMap((app) => app.data.downloads.map((file) => ({ app, file })))
  .sort((a, b) => newestFirst(a.file, b.file));
const filters = [...new Set(apps.flatMap((app) => app.data.targets))];
const single = apps.length === 1 ? apps[0] : undefined;
const watch = single && githubReleaseRepository(single.data.releases);
---

<section class="archive" id="release-archive" aria-labelledby="archive-heading" data-archive>
  <header class="archive-head">
    <h2 id="archive-heading" data-enter><RevealText text="Release archive" /></h2>
    <p data-enter>Search past builds by version, filename or processor architecture.</p>
  </header>
  <form class="archive-tools" aria-label="Release filters" hidden data-enter>
    <div class="archive-field archive-query">
      <label for="archive-query">Find a build</label>
      <span class="archive-input"
        ><i aria-hidden="true"></i>
        <input
          id="archive-query"
          type="search"
          name="q"
          placeholder="Version or filename"
          maxlength="160"
        ></span
      >
    </div>
    {apps.length > 1 && (
      <div class="archive-field">
        <label for="archive-app">App</label>
        <select id="archive-app" name="app">
          <option value="">All apps</option>
          {apps.map((app) => (
            <option value={app.id}>{app.data.name}</option>
          ))}
        </select>
      </div>
    )}
    <div class="archive-field">
      <label for="archive-platform">Platform</label
      ><select id="archive-platform" name="platform">
        <option value="">All platforms</option>
        {filters.map((name) => <option>{name}</option>)}
      </select>
    </div>
    <div class="archive-field">
      <label for="archive-channel">Channel</label
      ><select id="archive-channel" name="channel">
        <option value="">All channels</option>
        {Object.entries(channelLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </div>
    {builds.length > 1 && (
      <div class="archive-field">
        <label for="archive-order">Order</label>
        <select id="archive-order" name="order">
          <option value="">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </div>
    )}
  </form>
  <div class="archive-count" data-enter>
    <p role="status" aria-live="polite" data-archive-count>
      {builds.length} {builds.length === 1 ? 'build' : 'builds'}
    </p>
    <button type="button" data-archive-clear hidden>Clear filters</button>
  </div>
  <div data-archive-list data-enter>
    {builds.map(({ app, file }) => (
      <details
        class="archive-build"
        data-archive-build
        data-platform={file.platform}
        data-app={app.id}
        data-channel={file.channel}
        data-date={file.releasedOn}
        data-keywords={[
          app.data.name,
          app.data.shortName,
          file.file,
          file.version,
          file.architecture,
          file.platform,
          channelLabels[file.channel],
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase()}
      >
        <summary>
          <span class="build-identity">
            <strong>{file.file}</strong>
            <span>
              {app.data.name} · Version {file.version}
            </span>
          </span>
          <span class="build-target">
            {file.platform}
            {file.architecture && ` · ${file.architecture}`}
          </span>
          <span class="build-channel">{channelLabels[file.channel]}</span>
          {file.releasedOn && (
            <time datetime={file.releasedOn}>{releaseDate(file.releasedOn)}</time>
          )}
          <i class="archive-chevron" aria-hidden="true"></i>
        </summary>
        <div class="build-detail">
          <div class="build-actions">
            <a class="btn primary" href={file.url} aria-label={`Download ${file.file}`}>
              Download file <span aria-hidden="true">↓</span>
            </a>
            {file.notesUrl && (
              <a class="text-link" href={file.notesUrl}>
                Release notes
              </a>
            )}
            {file.bytes && <span class="build-size">{fileSize(file.bytes)}</span>}
          </div>
          {file.sha256 && (
            <div class="build-hash">
              <strong>SHA-256</strong>
              <code>{file.sha256}</code>
              <button type="button" data-copy-hash hidden>
                Copy checksum
              </button>
            </div>
          )}
        </div>
      </details>
    ))}
  </div>
  <div class="archive-empty" data-archive-empty hidden={builds.length > 0}>
    <div class="archive-trays" aria-hidden="true"><i></i><i></i><i></i></div>
    <div>
      <h3 data-empty-heading>No published builds yet</h3>
      <p data-empty-body>
        {single
          ? `${single.data.shortName} is still in development. Its first public build will appear here.`
          : 'Published builds from the ZeroCloud apps will appear here.'}
      </p>
    </div>
  </div>
  {watch && (
    <details class="archive-watch">
      <summary>
        Get release updates on GitHub <i class="archive-chevron" aria-hidden="true"></i>
      </summary>
      <p>
        On the repository page, open <strong>Watch</strong>, choose <strong>Custom</strong>, then
        select <strong>Releases</strong>.
      </p>
      <a class="text-link" href={watch}>
        Open the repository <span aria-hidden="true">↗</span>
      </a>
    </details>
  )}
</section>
<script>
  import '../scripts/release-archive';
</script>
