---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CatalogBrowser from '../components/CatalogBrowser.astro';
import ProductMark from '../components/ProductMark.astro';
import RevealText from '../components/RevealText.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { allApps } from '../lib/content';
import { appLink, link } from '../lib/site';
import '../styles/directory.css';

const apps = await allApps();
---

<SiteLayout
  title="App directory — ZeroCloud"
  description="Explore ZeroCloud Hub, Share, Bucket, Cast, Seek and Ledger. Local apps for sharing, storage, casting, finding devices and shared budgeting."
  ><div class="frame directory-page">
    <Breadcrumbs items={[{ text: 'Home', href: link() }, { text: 'Apps' }]} />
    <header class="page-lead">
      <h1 data-enter><RevealText text="App directory." /></h1>
      <p data-enter>
        Choose the apps you need. Hub is here to bring them together when you want it.
      </p>
    </header>
    <CatalogBrowser kind="apps" categories={[...new Set(apps.map((app) => app.data.category))]}>
      <div class="index-list">
        {apps.map((app) => (
          <article
            class="directory-item"
            data-product={app.id}
            data-enter
            data-catalog-item
            data-category={app.data.category}
            data-catalog-key={[
              app.data.name,
              app.data.shortName,
              app.data.description,
              app.data.category,
              ...app.data.targets,
            ]
              .join(' ')
              .toLowerCase()}
          >
            <a class="directory-card" href={appLink(app.id)}>
              <div class="directory-card-top">
                <ProductMark id={app.id} />
                <span class="directory-card-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              <div class="directory-card-copy">
                <h2>{app.data.name}</h2>
                <p>{app.data.description}</p>
              </div>
              <div class="directory-card-bottom">
                <span class="directory-platforms">{app.data.targets.join(' · ')}</span>
                <span class="text-link">Explore {app.data.shortName}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </CatalogBrowser>
  </div></SiteLayout
>
