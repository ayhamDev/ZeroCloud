---
import AppOverview from '../components/AppOverview.astro';
import FamilyHome from '../components/FamilyHome.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { currentEdition } from '../lib/content';

const app = await currentEdition();
---

<SiteLayout
  title={app ? `${app.data.name} — Overview` : 'ZeroCloud — Software for your own devices'}
  description={app?.data.description ??
    'Discover ZeroCloud Hub, Share, Bucket and Cast. Share files, sync your collection and cast screens across your devices with zero required cloud services.'}
>
  {app ? <AppOverview app={app} /> : <FamilyHome />}
</SiteLayout>
