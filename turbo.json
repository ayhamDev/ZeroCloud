{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "JAVA_HOME",
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "LOCALAPPDATA",
    "HUTCH_HOME",
    "PLAYWRIGHT_BROWSERS_PATH",
    "ZEROCLOUD_EXTERNAL_SERVERS",
    "GRADLE_USER_HOME"
  ],
  "tasks": {
    "@zerocloud/site#build": {
      "dependsOn": ["^build"],
      "env": ["SITE_URL"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
